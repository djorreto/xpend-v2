# =================================
# Xpend V2 - Environment Variables
# =================================
# Copia este archivo a .env.local y completa con tus valores reales

# ---------------------------------
# Supabase Configuration
# ---------------------------------
# Obtén estos valores de: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Service Role Key (SOLO para operaciones admin, NUNCA expongas en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ---------------------------------
# App Configuration
# ---------------------------------
# URL base de tu aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------
# Optional: Otros servicios
# ---------------------------------
# Ejemplo: Analytics, Monitoring, etc.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------
# Development Only
# ---------------------------------
# Modo debug (opcional)
# DEBUG=false

# =================================
# NOTAS IMPORTANTES:
# =================================
# 1. NUNCA commitees .env.local a git (está en .gitignore)
# 2. Las variables NEXT_PUBLIC_* son visibles en el cliente
# 3. Las variables sin NEXT_PUBLIC_* solo están en el servidor
# 4. Reinicia el servidor después de cambiar variables
# =================================
